<?xml version="1.0" encoding="utf-8"?>
<!--
  Copied beside each exe as <name>.exe.config. Explorer marks every file
  unzipped from a browser download as coming from the internet, and .NET
  Framework refuses to load a marked assembly: pythonnet's
  Python.Runtime.dll then fails with "Failed to resolve
  Python.Runtime.Loader.Initialize" and the window never opens.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
